{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 1.0,
  "trading_mode": "futures",
  "margin_mode": "cross",
  "timeframe": "1m",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "position_mode": "hedge",
  "hedge_mode_enabled": true,
  "managed_pair": "ETH/USDT:USDT",
  "hedge": {
    "operation_mode": "paper",
    "read_only": true,
    "live_trading_enabled": false,
    "target_leverage": "2",
    "paper": {
      "initial_balance": "1000",
      "ohlcv_source": "dataprovider",
      "funding_source": "exchange",
      "maker_fee_rate": "0.0002",
      "taker_fee_rate": "0.0005",
      "market_slippage_bps": "0.5",
      "volume_participation": "0.05",
      "max_missing_candles": 0
    },
    "planner": {
      "long_enabled": true,
      "short_enabled": true,
      "core_wallet_exposure_long": "0.40",
      "core_wallet_exposure_short": "0.40",
      "tactical_wallet_exposure_long": "0",
      "tactical_wallet_exposure_short": "0",
      "max_wallet_exposure_long": "0.40",
      "max_wallet_exposure_short": "0.40",
      "max_gross_wallet_exposure": "0.70",
      "initial_entry_fraction": "1",
      "max_grid_layers": 1,
      "max_pending_entries": 1,
      "cooldown_seconds": 0,
      "target_net_wallet_exposure": "0"
    }
  },
  "strategy": "HPRLXQCETHStrategy"
}
